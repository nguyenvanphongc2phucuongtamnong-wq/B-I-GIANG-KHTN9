rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        (
          request.auth.token.email == 'nvphong.thcsphuninh@gmail.com' ||
          request.auth.token.email.matches('(?i)^nvphong\\.thcsphuninh@gmail\\.com$')
        );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection check
    match /test/{docId} {
      allow read, write: if true;
    }

    // User Profile collection (1 UID = 1 document)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isTeacher();
    }

    // Student Progress collection and subcollection
    match /studentProgress/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isTeacher();

      match /lessons/{lessonId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId) || isTeacher();
      }
    }

    // Legacy students collection
    match /students/{studentId} {
      allow read, write: if true;
    }
  }
}
