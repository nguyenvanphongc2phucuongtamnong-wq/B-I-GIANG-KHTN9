rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        (
          request.auth.token.email == 'nvphong.thcsphuninh@gmail.com' ||
          request.auth.token.email == 'nvphong.thcsphusninh@gmail.com' ||
          request.auth.token.email.matches('(?i)^nvphong\\.thcsphu(s)?ninh@gmail\\.com$')
        );
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Default deny all other documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection check (read-only)
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User Profile collection (1 UID = 1 document)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isTeacher();
    }

    // Student Progress collection and subcollection (strictly owner or teacher)
    match /studentProgress/{userId} {
      allow read: if isOwner(userId) || isTeacher();
      allow write: if isOwner(userId) || isTeacher();

      match /lessons/{lessonId} {
        allow read: if isOwner(userId) || isTeacher();
        allow write: if isOwner(userId) || isTeacher();
      }
    }

    // Legacy students collection (strictly signed in, owner or teacher write)
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isOwner(studentId) || isTeacher();
    }
  }
}
